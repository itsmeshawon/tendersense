# Supabase — values provided by user, never pulled from other projects or shell env.
# Real values go in .env.local (gitignored). This file is a template only.

# Origin only — do NOT include /rest/v1/ or a trailing slash.
NEXT_PUBLIC_SUPABASE_URL=

# Publishable / anon key (safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret / service role key — server-only. Never import into client code.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string for migrations.
# Prefer Session pooler: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=
